// The module's ROOT package: the command line entry point.
//
// It exists so `moon run .` and `moon install` have something to run, and so
// the module has one obvious executable. All the logic lives in src/mdcli;
// this file only forwards to it.
//
// The entry point lives here rather than in src/mdcli because `fn main` is
// only allowed in an executable package.

pkgtype(kind: "executable")

import {
  "riantr/moonbit_markdown/src/mdcli",
  "moonbitlang/core/env",
}
