// The async runtime the native and wasm builds run on is
// `moonbitlang/core/async`, which the toolchain marks as experimental. The
// option says that this package knows that and accepts it: the runtime is
// not downloaded from the registry and pinned, so it is whatever the
// toolchain carries.
//
// The tool itself is synchronous on every target, so this package builds
// for all four of them. What differs between the targets is the file and
// process layer, and each target brings its own file: only the one that
// belongs to the target being built is compiled.
options(
  "allow-experimental-packages": true,
  targets: {
    "argv_native.mbt": [ "native", "wasm", "wasm-gc" ],
    "argv_js.mbt": [ "js" ],
    "io_native.mbt": [ "native", "wasm" ],
    "io_js.mbt": [ "js" ],
    "io_wasm_gc.mbt": [ "wasm-gc" ],
  },
)

import {
  "riantr/moonbit_markdown/src/md",
  "riantr/moonbit_markdown/src/mermaid",
  "riantr/moonbit_markdown/src/printpdf",
  "riantr/moonbit_markdown/src/text",
  "moonbitlang/core/env",
}

// The file system and the process runtime of the toolchain. They exist for
// native and wasm only, so they are imported for those targets alone: the
// js build uses Node's own modules, and the wasm-gc build uses the file
// system bridge of the wasm host.
#cfg(any(target="native", target="wasm"))
import {
  "moonbitlang/core/async",
  "moonbitlang/core/async/fs",
  "moonbitlang/core/async/process",
}

// The exit code of a program comes back from Node as text, and the standard
// library is what reads it back as a number. Only the js build needs it.
#cfg(target="js")
import {
  "moonbitlang/core/string",
}
