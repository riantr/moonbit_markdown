# The dependency cache and the build tree. Neither belongs in the repository:
# moon.mod pins the version of the one dependency, and the compiler rebuilds
# _build/ from the sources on every run.
/.mooncakes/
/_build/

# The documents in the root are build products. README.md lists the command
# that produces each one, and `ci/check_artifacts.py` checks the structure of
# the ones that need nothing but this repository.
/moonbit_doubleML_state_diagram.html
/moonbit_doubleML_state_diagram.pdf
/moonbit_doubleML_state_diagram_moonbit.pdf
/moonbit_doubleML_state_diagram_moonbit.print.html
/index.html
/md_with_diagram.html
/md_with_diagram.pdf

# The screenshot verify_page.js takes on every run.
/moonbit_page.png

# The CommonMark spec and the work of measuring against it: the spec is
# downloaded, and the rendered examples are build products.
/tools/commonmark/

# The node modules the reference implementation's own scripts need: env.js
# looks for puppeteer in a local install first, and `npm i puppeteer` puts it
# here. It is a dependency of the tooling, not of this package.
/node_modules/

# What ci/ci.py writes: the JSON report and the full output of a failing step.
# A failing step's transcript is evidence for one run, not a file to keep.
/ci/artifacts/
__pycache__/
